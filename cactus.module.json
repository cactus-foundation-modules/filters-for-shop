{
  "name": "filters-for-shop",
  "version": "0.1.21",
  "tablePrefix": "flt_",
  "description": "Grouped storefront filters for the shop, built for catalogues with rich variations: define a filter like Blue that stands for any number of real option values (Blue, Stevia Blue, Sky Blue...), drop the filter grid block on category and collection pages, and filtered product cards show the matching variation's own photo and open the product with those options already chosen.",
  "requiresCoreVersion": "0.5.1026",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.213"
    },
    {
      "name": "shop-variations",
      "minVersion": "0.1.107"
    }
  ],
  "permissions": [],
  "settingsTabs": [
    {
      "id": "filters-for-shop",
      "label": "Filters",
      "permission": "shop.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/SettingsTab",
      "component": "ShopFiltersSettingsTab"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "extensionPoints": [
    {
      "point": "shop.products-tabs",
      "id": "filters-for-shop",
      "label": "Filters",
      "order": 40,
      "permission": "shop.products",
      "import": "./components/admin/FiltersTab",
      "component": "FiltersTab"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopFilterGrid",
      "import": "./components/puck/ShopFilterGrid",
      "component": "shopFilterGridPuckComponent",
      "rscComponent": "shopFilterGridPuckRscComponent",
      "rscImport": "./components/puck/ShopFilterGrid.rsc",
      "layoutTypes": [
        "shopIndex",
        "shopCategory",
        "shopCollection",
        "shopTag"
      ]
    }
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": []
  },
  "teardown": [
    "flt_filter_rules",
    "flt_filters",
    "flt_groups",
    "flt_settings"
  ]
}
