{
  "name": "filters-for-shop",
  "version": "0.1.46",
  "tablePrefix": "flt_",
  "description": "Grouped storefront filters for the shop, built for catalogues with rich variations: define a filter like Blue that stands for any number of real option values (Blue, Stevia Blue, Sky Blue...), drop the filter grid block on category and collection pages, and filtered product cards show the matching variation's own photo and open the product with those options already chosen. Turn any filtered view into a page of its own - Green Office Chairs, at its own address, with its own page title, description and designed intro.",
  "publicRootSlug": {
    "page": "./app/root/[slug]/page",
    "claimImport": "./lib/root-slug",
    "claimExport": "filtersClaimsRootSlug"
  },
  "requiresCoreVersion": "0.5.1306",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.333"
    },
    {
      "name": "shop-variations",
      "minVersion": "0.1.107"
    }
  ],
  "permissions": [],
  "settingsTabs": [
    {
      "id": "filters-for-shop",
      "label": "Filters",
      "permission": "shop.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/SettingsTab",
      "component": "ShopFiltersSettingsTab"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "layoutStarters": [
    {
      "layoutType": "shopSupplier",
      "import": "./lib/starterLayouts",
      "export": "shopSupplierFilterStarters"
    }
  ],
  "extensionPoints": [
    {
      "point": "shop.products-tabs",
      "id": "filters-for-shop",
      "label": "Filters",
      "order": 40,
      "permission": "shop.products",
      "import": "./components/admin/FiltersTab",
      "component": "FiltersTab"
    },
    {
      "point": "shop.products-tabs",
      "id": "filters-collections",
      "label": "Filter Collections",
      "order": 41,
      "permission": "shop.products",
      "import": "./components/admin/FilterCollectionsTab",
      "component": "FilterCollectionsTab"
    },
    {
      "point": "search.product-filters",
      "id": "filters-for-shop",
      "import": "./lib/search-filter-grid",
      "component": "filtersSearchGridProvider"
    },
    {
      "point": "shop.collection-index-sources",
      "id": "filters-for-shop",
      "label": "Filter collections",
      "import": "./lib/collection-index-source",
      "component": "filtersCollectionIndexSource"
    },
    {
      "point": "core.media-reference-rewriters",
      "id": "filters-for-shop",
      "import": "./lib/media-reference-rewriter",
      "component": "filtersMediaReferenceRewriter"
    },
    {
      "point": "core.media-usage-providers",
      "id": "filters-for-shop",
      "import": "./lib/media-usage-provider",
      "component": "filtersMediaUsageProvider"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopFilterGrid",
      "import": "./components/puck/ShopFilterGrid",
      "component": "shopFilterGridPuckComponent",
      "rscComponent": "shopFilterGridPuckRscComponent",
      "rscImport": "./components/puck/ShopFilterGrid.rsc",
      "layoutTypes": [
        "shopIndex",
        "shopCategory",
        "shopCollection",
        "shopTag",
        "shopSupplier",
        "filterCollection"
      ]
    },
    {
      "type": "FilterCollectionHeader",
      "import": "./components/puck/FilterCollectionHeader",
      "component": "filterCollectionHeaderPuckComponent",
      "rscComponent": "filterCollectionHeaderPuckRscComponent",
      "rscImport": "./components/puck/FilterCollectionHeader.rsc",
      "layoutTypes": [
        "filterCollection"
      ]
    },
    {
      "type": "FilterCollectionIntro",
      "import": "./components/puck/FilterCollectionIntro",
      "component": "filterCollectionIntroPuckComponent",
      "rscComponent": "filterCollectionIntroPuckRscComponent",
      "rscImport": "./components/puck/FilterCollectionIntro.rsc",
      "layoutTypes": [
        "filterCollection"
      ]
    }
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": []
  },
  "teardown": [
    "flt_collection_filters",
    "flt_collections",
    "flt_filter_rules",
    "flt_filters",
    "flt_groups",
    "flt_settings"
  ],
  "layoutTypes": {
    "groupLabel": "Filters",
    "types": [
      {
        "key": "filterCollection",
        "label": "Filter collection page"
      }
    ]
  }
}
